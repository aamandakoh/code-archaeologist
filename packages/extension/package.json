{
  "name": "code-archaeologist",
  "displayName": "Code Archaeologist",
  "description": "Select code and see how it evolved commit by commit, and why.",
  "version": "0.3.0",
  "private": true,
  "publisher": "code-archaeologist",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aamandakoh/code-archaeologist"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "codeArchaeologist.trace",
        "title": "Why is this here?",
        "category": "Code Archaeologist"
      },
      {
        "command": "codeArchaeologist.setApiKey",
        "title": "Set Gemini API key",
        "category": "Code Archaeologist"
      },
      {
        "command": "codeArchaeologist.setGitHubToken",
        "title": "Set GitHub token",
        "category": "Code Archaeologist"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeArchaeologist.trace",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "codeArchaeologist.trace",
          "when": "editorIsOpen"
        }
      ]
    },
    "configuration": {
      "title": "Code Archaeologist",
      "properties": {
        "codeArchaeologist.model": {
          "type": "string",
          "default": "gemini-3.5-flash",
          "markdownDescription": "Gemini model that writes the notes, summary and verdict. Any model id from [Google AI Studio](https://aistudio.google.com) works. The API key is set with **Code Archaeologist: Set Gemini API key**, or read from the `GEMINI_API_KEY` environment variable. Pull requests, reviews and issues are read from GitHub with the token set by **Code Archaeologist: Set GitHub token** (or `GITHUB_TOKEN`); without one GitHub allows 60 requests an hour."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@code-archaeologist/core": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0"
  }
}
